# Trove P&P: server hardening (Apache / LiteSpeed, standard on cPanel hosting)

# No directory listings
Options -Indexes

# Include-only PHP files and dotfiles are never served directly, even if PHP
# were ever misconfigured and .php files were sent as plain text
<FilesMatch "^(enquiry-(validate|template|secret)\.php|\..*)$">
  Require all denied
</FilesMatch>

# The enquiry form never needs more than a few KB: refuse big uploads before PHP parses them
<Files "enquiry.php">
  LimitRequestBody 65536
</Files>

# Turn off PHP error output to visitors where the host allows it
<IfModule mod_php.c>
  php_flag display_errors Off
  php_flag expose_php Off
</IfModule>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; frame-src https://maps.google.com https://www.google.com; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>
